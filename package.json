{
  "name": "awcp-examples",
  "version": "0.1.0",
  "private": true,
  "description": "AWCP 证券办公示例项目",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "webpack serve --config webpack.config.cjs --mode development",
    "build": "webpack --config webpack.config.cjs --mode production",
    "lint": "eslint src package tests --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "format:check": "prettier . --check",
    "check:plans": "node scripts/checkPlans.mjs",
    "quality": "pnpm run check:protocol && pnpm run check:plans && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "check:protocol": "node scripts/checkProtocol.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "6.0.0",
    "ajv": "8.20.0",
    "antd": "6.4.5",
    "dayjs": "1.11.10",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@swc/core": "1.7.0",
    "@types/node": "20.11.30",
    "@types/react": "18.2.22",
    "@types/react-dom": "18.2.7",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "css-loader": "6.8.1",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.7",
    "html-webpack-plugin": "5.5.3",
    "jsdom": "24.1.3",
    "prettier": "3.3.3",
    "style-loader": "3.3.3",
    "swc-loader": "0.2.6",
    "typescript": "5.2.2",
    "vitest": "2.1.9",
    "webpack": "5.88.2",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "5.0.4"
  }
}
