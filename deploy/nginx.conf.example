# Optional local reverse proxy example. Set the real host/TLS before remote deployment.
# The Go service owns SPA routing and /api. The former static-only deployment is obsolete.
server {
    listen 80;
    server_name _;

    # Browser SSE: distinct from the MCP transport endpoint.
    location = /api/v1/events {
        proxy_pass http://127.0.0.1:2181;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        gzip off;
        proxy_cache off;
        proxy_read_timeout 65s;
    }
    location / {
        proxy_pass http://127.0.0.1:2181;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
