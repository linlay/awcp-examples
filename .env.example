# Server environment contract. Paths below assume launch from backend/.
# Export values in your shell or inject through the service/container environment.
AWCP_LISTEN=127.0.0.1:2181
AWCP_DATABASE=../data/awcp.sqlite
AWCP_STATIC_DIR=../frontend/dist
AWCP_ALLOWED_ORIGINS=http://127.0.0.1:2180,http://127.0.0.1:2181
AWCP_SECURE_COOKIE=false
AWCP_DATA_PROFILE=acceptance

# Embedded demo MCP: same Go process and SQLite, no external identity service.
# Local default account: demo / demo. Public URLs require a custom password (8+ chars).
AWCP_MCP_ENABLED=true
AWCP_MCP_PUBLIC_URL=http://127.0.0.1:2181/mcp
AWCP_MCP_USERNAME=demo
AWCP_MCP_PASSWORD=demo
AWCP_MCP_RESET_ENABLED=false
AWCP_MCP_MAX_CONCURRENT=8
