# Optional additions inside the existing app HTTPS server. No extra service.
location = /mcp {
    proxy_pass http://127.0.0.1:11983;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Authorization $http_authorization;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 65s;
    client_max_body_size 1m;
}
location ^~ /.well-known/ {
    proxy_pass http://127.0.0.1:11983;
    proxy_set_header Host $host;
}
location ^~ /oauth/ {
    access_log off;
    proxy_pass http://127.0.0.1:11983;
    proxy_set_header Host $host;
    proxy_cache off;
    client_max_body_size 8k;
}
location ^~ /api/v1/mcp/ {
    access_log off;
    proxy_pass http://127.0.0.1:11983;
    proxy_set_header Host $host;
    proxy_cache off;
}
